# Existing shared production database
SOFTIQ_DB_URL=jdbc:mysql://your-database-host:3306/your-database
SOFTIQ_DB_USERNAME=replace-me
SOFTIQ_DB_PASSWORD=replace-me
SOFTIQ_MAIL_USERNAME=replace-me
SOFTIQ_MAIL_PASSWORD=replace-me
SOFTIQ_AUTOMATION_PASSWORD=replace-me
SOFTIQ_JWT_KEY=replace-with-existing-jwt-secret
RECAPTCHA_SECRET=replace-me
GOPAY_CLIENT_ID=replace-me
GOPAY_CLIENT_SECRET=replace-me
GOPAY_GO_ID=replace-me
# Optional HTTP API suite; point at the intended test target explicitly.
SOFTIQ_API_BASE_URL=https://your-api-host
SOFTIQ_API_TEST_EMAIL=replace-me
SOFTIQ_API_TEST_PASSWORD=replace-me
MODE_SELECTOR=html
